# Google Maps (carte des points de vente). Même clé que le CRM.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Dev-only quick login (bouton affiché uniquement si NODE_ENV=development).
# SANS préfixe NEXT_PUBLIC_ — ne doit jamais être défini sur Vercel.
